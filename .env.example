# Copy to .env and fill in. .env is git-ignored: never commit real credentials.

# The owner's super admin sign-in for the admin console (/admin-login).
# At build time next.config.ts keeps only the email and a SHA-256 hash of the password;
# the password itself is never sent to the browser. Leave both empty to use the demo
# super admin (superadmin@agrictec.app). Restart `npm run dev` / rebuild after changing.
# Password rules: 10+ characters with upper- and lower-case letters, a number and a symbol.
admin_email=
admin_password=

# Optional: minutes of inactivity before an admin is signed out (default 30).
# NEXT_PUBLIC_ADMIN_IDLE_MINUTES=30
